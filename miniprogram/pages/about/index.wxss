.about-page {
  min-height: 100vh;
  padding: 42rpx 34rpx 80rpx;
  background: #ffffff;
}

.about-hero {
  padding-top: 16rpx;
}

.about-kicker {
  color: #747a73;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.2;
}

.about-title {
  margin-top: 8rpx;
  color: #171917;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.08;
}

.about-subtitle {
  max-width: 600rpx;
  margin-top: 18rpx;
  color: #626861;
  font-size: 27rpx;
  line-height: 1.5;
}

.about-section {
  margin-top: 44rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #ebece8;
}

.section-title {
  color: #171917;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.25;
}

.section-body {
  margin-top: 12rpx;
  color: #626861;
  font-size: 25rpx;
  line-height: 1.55;
}

.about-link {
  color: #171917;
  font-weight: 600;
}

.group-qr-card {
  width: 520rpx;
  max-width: 100%;
  margin-top: 22rpx;
  overflow: hidden;
  border: 1rpx solid #ebece8;
  border-radius: 16rpx;
  background: #f7f7f5;
}

.group-qr-tap {
  opacity: 0.86;
}

.group-qr-image {
  display: block;
  width: 100%;
}
