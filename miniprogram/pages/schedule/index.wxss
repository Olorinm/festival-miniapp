.schedule-page {
  padding: 16rpx 24rpx 72rpx 18rpx;
  background: #ffffff;
}

.schedule-top {
  margin-left: 8rpx;
  margin-right: 2rpx;
}

.schedule-tool-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 10rpx;
}

.smart-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 0 0 auto;
  min-width: 154rpx;
  height: 58rpx;
  padding: 0 2rpx 0 10rpx;
  color: #171917;
  font-size: 22rpx;
  font-weight: 650;
  white-space: nowrap;
}

.smart-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  color: #c89a3a;
  animation: smart-twirl 4.8s ease-in-out infinite;
  transform-origin: 50% 50%;
}

.smart-spark {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.smart-spark-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(45deg);
}

.smart-spark-point {
  position: absolute;
  width: 0;
  height: 0;
}

.smart-spark-point.is-top {
  left: 50%;
  top: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 18rpx solid #c89a3a;
  transform: translateX(-50%);
}

.smart-spark-point.is-right {
  right: 0;
  top: 50%;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 18rpx solid #c89a3a;
  transform: translateY(-50%);
}

.smart-spark-point.is-bottom {
  left: 50%;
  bottom: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 18rpx solid #c89a3a;
  transform: translateX(-50%);
}

.smart-spark-point.is-left {
  left: 0;
  top: 50%;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-right: 18rpx solid #c89a3a;
  transform: translateY(-50%);
}

.smart-entry-tap {
  opacity: 0.62;
}

.smart-entry-label {
  color: #171917;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1;
}

.smart-arrow {
  color: #8f8878;
  font-size: 28rpx;
  font-weight: 520;
  line-height: 1;
  transform: translateY(-1rpx);
}

@keyframes smart-twirl {
  0% {
    transform: translateY(-1rpx) rotate(0deg);
  }
  14% {
    transform: translateY(-1rpx) rotate(360deg);
  }
  100% {
    transform: translateY(-1rpx) rotate(360deg);
  }
}

.schedule-search {
  flex: 1 1 auto;
  min-width: 0;
  height: 66rpx;
  margin-top: 0;
  border-radius: 16rpx;
  background: #f1f2ef;
}

.schedule-search .search-input {
  height: 66rpx;
  font-size: 26rpx;
}

.filter-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.schedule-filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.scope-segment {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  flex: 0 0 auto;
  padding: 4rpx;
  border-radius: 14rpx;
  background: #f1f2ef;
}

.scope-option {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  max-width: 168rpx;
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 11rpx;
  color: #60665f;
  font-size: 23rpx;
  font-weight: 610;
}

.scope-option.is-active {
  background: #171917;
  color: #ffffff;
  font-weight: 680;
}

.tool-filter-scroll {
  flex: 1 1 auto;
  min-width: 0;
  padding: 2rpx 0;
  white-space: nowrap;
}

.tool-filter-row {
  display: inline-flex;
  align-items: center;
  gap: 9rpx;
}

.tool-filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  flex: 0 0 auto;
  max-width: 190rpx;
  height: 52rpx;
  padding: 0 14rpx;
  border: 0;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx #e1e4df;
  color: #59615b;
  font-size: 22rpx;
  font-weight: 650;
}

.tool-filter-chip.is-active {
  background: #f4f7f8;
  box-shadow: inset 0 0 0 1rpx #c9d4dd;
  color: #3f5b73;
}

.filter-triangle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 18rpx;
  width: 18rpx;
  height: 18rpx;
  color: #7d8a94;
  font-size: 13rpx;
  line-height: 18rpx;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  flex: 0 0 auto;
  max-width: 340rpx;
  height: 52rpx;
  padding: 0 17rpx;
  border: 1rpx solid #e7e7e2;
  border-radius: 10rpx;
  background: #ffffff;
  color: #676d66;
  font-size: 23rpx;
  font-weight: 620;
}

.filter-chip.is-active {
  border-color: #171917;
  background: #171917;
  color: #ffffff;
}

.filter-label {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-count {
  color: #969a93;
  font-size: 20rpx;
  font-weight: 560;
}

.filter-chip.is-active .filter-count {
  color: rgba(255, 255, 255, 0.72);
}

.filter-divider {
  flex: 0 0 auto;
  width: 1rpx;
  height: 32rpx;
  margin: 0 4rpx;
  background: #e2e4df;
}

.filter-option-scroll {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.filter-option-row {
  display: inline-flex;
  gap: 10rpx;
}

.filter-option {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 50rpx;
  max-width: 360rpx;
  padding: 0 16rpx;
  border: 1rpx solid transparent;
  border-radius: 10rpx;
  background: #f7f7f5;
  color: #646963;
  font-size: 23rpx;
}

.filter-option.is-picked {
  border-color: #dedfd9;
  background: #ffffff;
  color: #171917;
  font-weight: 650;
}

.filter-option-label {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-option-count {
  color: #98928b;
  font-size: 20rpx;
}

.screening-days {
  display: block;
  margin-top: 24rpx;
}

.screening-day + .screening-day {
  margin-top: 46rpx;
}

.screening-day-head {
  position: sticky;
  top: 0;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  margin: 0 -2rpx 18rpx;
  padding: 0 4rpx 0 0;
  border-bottom: 1rpx solid #ebeae6;
  background: #ffffff;
}

.screening-day-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1 1 0;
  min-width: 0;
}

.screening-day-caret {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 24rpx;
  width: 24rpx;
  height: 28rpx;
  color: #6a7d8e;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  transform-origin: center;
  transform: translateY(-2rpx);
}

.screening-day-caret.is-open {
  transform: translateY(-3rpx);
}

.screening-day-label,
.screening-day-title {
  display: block;
  min-width: 0;
  flex: 1 1 0;
  overflow: hidden;
  color: #3f5b73;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.screening-day-count {
  flex: 0 0 auto;
  color: #8b8d87;
  font-size: 22rpx;
}

.screening-list {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.screening-list::before {
  content: "";
  position: absolute;
  top: 11rpx;
  bottom: 18rpx;
  left: 90rpx;
  width: 4rpx;
  background: #eef0ec;
  transform: translateX(-50%);
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: stretch;
}

.timeline-item.is-selected::before {
  content: "";
  position: absolute;
  z-index: 1;
  top: 11rpx;
  bottom: -35rpx;
  left: 90rpx;
  width: 4rpx;
  border-radius: 999rpx;
  background: #8a97a3;
  pointer-events: none;
  transform: translateX(-50%);
}

.timeline-item:last-child.is-selected::before {
  bottom: 18rpx;
}

.timeline-item.is-selected.has-conflict::before {
  background: #bd5b55;
}

.timeline-rail {
  position: relative;
  min-height: 156rpx;
}

.time-stamp {
  position: relative;
  z-index: 2;
  width: 68rpx;
  padding: 0 0 8rpx;
  background: #ffffff;
  text-align: right;
}

.timeline-node {
  position: absolute;
  z-index: 3;
  top: 0;
  left: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22rpx;
  height: 22rpx;
  box-sizing: border-box;
  border: 3rpx solid #d6d9d3;
  border-radius: 50%;
  background: #ffffff;
  transform: translateX(-50%);
}

.timeline-node.is-selected {
  border-color: #697887;
  background: #697887;
}

.timeline-node.has-conflict {
  top: 1rpx;
  left: 90rpx;
  width: 20rpx;
  height: 20rpx;
  border: 0;
  background: #bd4b4b;
}

.conflict-cross {
  position: relative;
  width: 100%;
  height: 100%;
}

.conflict-cross-line {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.conflict-cross-line.is-a {
  transform: translate(-50%, -50%) rotate(45deg);
}

.conflict-cross-line.is-b {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.screening-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 158rpx;
  gap: 20rpx;
  align-items: center;
  padding: 28rpx 24rpx 28rpx 28rpx;
  border: 1rpx solid #f0f0ec;
  border-radius: 16rpx;
  background: #f7f7f5;
}

.screening-card.is-selected {
  border-color: #f0f0ec;
  background: #f7f7f5;
  box-shadow: none;
}

.start {
  color: #171917;
  font-size: 25rpx;
  font-weight: 680;
}

.end {
  display: block;
  margin-top: 6rpx;
  color: #858982;
  font-size: 20rpx;
}

.screening-body {
  display: block;
  min-width: 0;
  color: inherit;
}

.screen-title {
  min-width: 0;
  font-size: 29rpx;
  font-weight: 680;
  line-height: 1.3;
}

.screen-meta,
.venue-line {
  margin-top: 6rpx;
  color: #686f69;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.interest,
.price,
.ticket {
  padding: 6rpx 11rpx;
  border-radius: 7rpx;
  background: #ffffff;
  color: #626760;
  font-size: 20rpx;
  line-height: 1.2;
}

.tone-red {
  background: #1f211d;
  color: #f0c864;
}

.tone-amber {
  background: #f4ecd9;
  color: #7d5a24;
}

.tone-teal {
  background: #edf2ee;
  color: #536158;
}

.tone-blue {
  background: #edf4fb;
  color: #41607c;
}

.tone-gray {
  background: #f0efec;
  color: #6b6964;
}

.screening-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.pick-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  height: 62rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #cfd2cc;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2e352f;
  font-size: 22rpx;
  font-weight: 680;
  overflow: hidden;
}

.action-tap {
  opacity: 0.72;
  transform: scale(0.98);
}

.pick-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 24rpx;
  height: 24rpx;
  color: currentColor;
}

.pick-symbol.is-filled {
  color: currentColor;
}

.action-glyph {
  position: relative;
  width: 100%;
  height: 100%;
}

.glyph-line {
  position: absolute;
  left: 50%;
  top: 50%;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform-origin: center;
}

.action-glyph.is-plus .glyph-line {
  width: 18rpx;
}

.action-glyph.is-plus .is-a {
  transform: translate(-50%, -50%);
}

.action-glyph.is-plus .is-b {
  transform: translate(-50%, -50%) rotate(90deg);
}

.action-glyph.is-check .glyph-line {
  background: currentColor;
}

.action-glyph.is-check .is-a {
  width: 9rpx;
  transform: translate(-75%, 40%) rotate(45deg);
}

.action-glyph.is-check .is-b {
  width: 18rpx;
  transform: translate(-20%, -8%) rotate(-45deg);
}

.pick-label {
  max-width: 100%;
  overflow: hidden;
  color: currentColor;
  font-size: 22rpx;
  font-weight: 680;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-button.is-on {
  border-color: #171917;
  background: #171917;
  color: #ffffff;
}

.pick-button.is-on .pick-label {
  color: currentColor;
}

.pick-button.has-conflict {
  border-color: #cfd2cc;
  color: #2e352f;
}

.pick-button.is-switch {
  border-color: #b9c0b8;
  background: #fbfcfa;
}

.action-note {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #8b9189;
  font-size: 18rpx;
  line-height: 1.1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  margin: 108rpx 34rpx 0;
  text-align: center;
}

.empty-start {
  max-width: 620rpx;
  margin: 0 auto;
}

.empty-copy {
  max-width: 560rpx;
  margin: 0 auto;
}

.empty-line {
  color: #737872;
  font-size: 25rpx;
  font-weight: 520;
  line-height: 1.45;
}

.empty-line + .empty-line {
  margin-top: 8rpx;
}

.empty-paragraph {
  color: #737872;
  font-size: 30rpx;
  font-weight: 520;
  line-height: 1.55;
}

.empty-sentence + .empty-sentence {
  margin-top: 18rpx;
}

.empty-inline-link {
  display: inline-block;
  color: #23435f;
  font-weight: 680;
  white-space: nowrap;
}

.empty-inline-tap {
  opacity: 0.7;
}

.smart-mask {
  position: fixed;
  z-index: 20;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  background: rgba(22, 23, 22, 0.32);
}

.smart-sheet {
  width: 100%;
  max-width: 650rpx;
  max-height: 72vh;
  padding: 26rpx;
  border: 1rpx solid #e5e5df;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 54rpx rgba(22, 23, 22, 0.16);
}

.smart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.smart-title {
  color: #161716;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.15;
}

.smart-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  color: #737871;
  font-size: 36rpx;
  line-height: 1;
}

.smart-input-shell {
  width: 100%;
  min-height: 292rpx;
  padding: 20rpx;
  border: 1rpx solid #e2e3df;
  border-radius: 10rpx;
  background: #ffffff;
}

.smart-input-shell.is-focused {
  border-color: #d7d9d3;
  box-shadow: none;
}

.smart-prompt-title {
  color: #525852;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.smart-prompt-line {
  margin-top: 7rpx;
  color: #7b817b;
  font-size: 24rpx;
  line-height: 1.42;
}

.smart-input {
  display: block;
  width: 100%;
  max-width: 100%;
  min-height: 82rpx;
  max-height: 340rpx;
  margin-top: 16rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #171917;
  font-size: 25rpx;
  line-height: 1.46;
}

.smart-input.has-value {
  min-height: 236rpx;
  margin-top: 0;
}

.smart-actions {
  display: grid;
  grid-template-columns: 152rpx minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.smart-secondary,
.smart-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 68rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 650;
}

.smart-secondary {
  border: 1rpx solid #e2e3df;
  color: #525952;
}

.smart-primary {
  gap: 8rpx;
  background: linear-gradient(135deg, #2b2c28 0%, #3b3c35 62%, #4b4639 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(22, 23, 22, 0.18);
}

.smart-primary-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(240, 200, 100, 0.14);
  color: #f2d58a;
  font-size: 20rpx;
  line-height: 1;
}

.smart-primary.is-disabled {
  background: #aeb3ab;
  box-shadow: none;
}
