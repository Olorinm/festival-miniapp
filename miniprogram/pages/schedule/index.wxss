.schedule-page {
  padding: 16rpx 24rpx 72rpx 24rpx;
  background: #ffffff;
}

.schedule-top {
  margin-left: 8rpx;
  margin-right: 2rpx;
}

.schedule-tool-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 10rpx;
}

.smart-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 0 0 auto;
  min-width: 154rpx;
  height: 58rpx;
  padding: 0 2rpx 0 10rpx;
  color: #171917;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.smart-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  color: #c89a3a;
  animation: smart-twirl 4.8s ease-in-out infinite;
  transform-origin: 50% 50%;
}

.smart-spark {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.smart-spark-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(45deg);
}

.smart-spark-point {
  position: absolute;
  width: 0;
  height: 0;
}

.smart-spark-point.is-top {
  left: 50%;
  top: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 18rpx solid currentColor;
  transform: translateX(-50%);
}

.smart-spark-point.is-right {
  right: 0;
  top: 50%;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 18rpx solid currentColor;
  transform: translateY(-50%);
}

.smart-spark-point.is-bottom {
  left: 50%;
  bottom: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 18rpx solid currentColor;
  transform: translateX(-50%);
}

.smart-spark-point.is-left {
  left: 0;
  top: 50%;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-right: 18rpx solid currentColor;
  transform: translateY(-50%);
}

.smart-entry-label {
  color: #171917;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.smart-arrow {
  color: #8f8878;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  transform: translateY(-1rpx);
}

@keyframes smart-twirl {
  0% {
    transform: translateY(-1rpx) rotate(0deg);
  }
  14% {
    transform: translateY(-1rpx) rotate(360deg);
  }
  100% {
    transform: translateY(-1rpx) rotate(360deg);
  }
}

.schedule-search {
  flex: 1 1 auto;
  min-width: 0;
  height: 66rpx;
  margin-top: 0;
  border-radius: 16rpx;
  background: #f1f2ef;
}

.schedule-search .search-input {
  height: 66rpx;
  font-size: 26rpx;
}

.filter-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.schedule-filter-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.scope-segment {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  flex: 0 0 auto;
  padding: 4rpx;
  border-radius: 12rpx;
  background: #f1f2ef;
}

.scope-option {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  max-width: 168rpx;
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  color: #60665f;
  font-size: 23rpx;
  font-weight: 600;
}

.scope-option.is-active {
  background: #171917;
  color: #ffffff;
  font-weight: 600;
}

.tool-filter-scroll {
  flex: 1 1 auto;
  min-width: 0;
  padding: 2rpx 0;
  white-space: nowrap;
}

.tool-filter-row {
  display: inline-flex;
  align-items: center;
  gap: 9rpx;
}

.tool-filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  flex: 0 0 auto;
  min-width: 92rpx;
  max-width: 220rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border: 0;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx #e1e4df;
  color: #59615b;
  font-size: 22rpx;
  font-weight: 600;
}

.tool-filter-chip.is-active {
  background: #f4f7f8;
  box-shadow: inset 0 0 0 1rpx #c9d4dd;
  color: #3f5b73;
}

.filter-triangle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 18rpx;
  width: 18rpx;
  height: 18rpx;
  color: #8b8d87;
  font-size: 13rpx;
  line-height: 18rpx;
}

.filter-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  flex: 0 0 auto;
  max-width: 340rpx;
  height: 52rpx;
  padding: 0 17rpx;
  border: 1rpx solid #e7e7e2;
  border-radius: 12rpx;
  background: #ffffff;
  color: #676d66;
  font-size: 23rpx;
  font-weight: 600;
}

.filter-chip.is-active {
  border-color: #171917;
  background: #171917;
  color: #ffffff;
}

.filter-label {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-count {
  color: #969a93;
  font-size: 20rpx;
  font-weight: 500;
}

.filter-chip.is-active .filter-count {
  color: rgba(255, 255, 255, 0.72);
}

.filter-divider {
  flex: 0 0 auto;
  width: 1rpx;
  height: 32rpx;
  margin: 0 4rpx;
  background: #e2e4df;
}

.filter-option-scroll {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.filter-option-row {
  display: inline-flex;
  gap: 10rpx;
}

.filter-option {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 50rpx;
  max-width: 360rpx;
  padding: 0 16rpx;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  background: #f7f7f5;
  color: #646963;
  font-size: 23rpx;
}

.filter-option.is-picked {
  border-color: #dedfd9;
  background: #ffffff;
  color: #171917;
  font-weight: 600;
}

.filter-option-label {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-option-count {
  color: #98928b;
  font-size: 20rpx;
}

.filter-panel {
  margin-top: 18rpx;
  padding: 8rpx 18rpx 18rpx;
  border-radius: 16rpx;
  background: #f4f4f2;
}

.filter-group {
  margin-top: 14rpx;
}

.filter-group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.filter-slider-value {
  color: #171917;
  font-size: 22rpx;
  font-weight: 600;
}

.filter-group-label {
  color: #737872;
  font-size: 22rpx;
  font-weight: 600;
}

.filter-group-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-group-row {
  display: inline-flex;
  gap: 10rpx;
}

.filter-panel .filter-option {
  background: #ffffff;
}

.filter-panel .filter-option.is-picked {
  border-color: #171917;
  background: #171917;
  color: #ffffff;
}

.filter-panel .filter-option.is-picked .filter-option-count {
  color: rgba(255, 255, 255, 0.7);
}

.filter-panel-reset {
  display: inline-block;
  margin-top: 18rpx;
  color: #59615b;
  font-size: 23rpx;
  font-weight: 600;
}

.field-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 80rpx;
  padding: 0 6rpx;
}

.field-row + .field-row {
  border-top: 1rpx solid #e7e7e2;
}

.field-row-text {
  min-width: 0;
  flex: 1 1 auto;
}

.field-row-label {
  color: #171917;
  font-size: 25rpx;
  font-weight: 600;
}

.field-row-desc {
  margin-top: 4rpx;
  color: #8a8f88;
  font-size: 21rpx;
}

.field-switch {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  width: 78rpx;
  height: 44rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #d9dcd6;
}

.field-switch.is-on {
  justify-content: flex-end;
  background: #171917;
}

.field-switch-dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ffffff;
}

.screening-days {
  display: block;
  margin-top: 24rpx;
}

.screening-day + .screening-day {
  margin-top: 40rpx;
}

.screening-day-head {
  position: sticky;
  top: 0;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  margin: 0 -2rpx 18rpx;
  padding: 0 4rpx 0 0;
  border-bottom: 1rpx solid #ebeae6;
  background: #ffffff;
}

.screening-day-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1 1 0;
  min-width: 0;
}

.screening-day-caret {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 24rpx;
  width: 24rpx;
  height: 28rpx;
  color: #8b8d87;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  transform-origin: center;
  transform: translateY(-2rpx);
}

.screening-day-caret.is-open {
  transform: translateY(-3rpx);
}

.screening-day-label,
.screening-day-title {
  display: block;
  min-width: 0;
  flex: 1 1 0;
  overflow: hidden;
  color: #171917;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.screening-day-count {
  flex: 0 0 auto;
  color: #8b8d87;
  font-size: 22rpx;
}

.screening-list {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.screening-list::before {
  content: "";
  position: absolute;
  top: 11rpx;
  bottom: 18rpx;
  left: 90rpx;
  width: 2rpx;
  background: #e2e2de;
  transform: translateX(-50%);
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 92rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: stretch;
}

.timeline-item.is-selected::before {
  content: "";
  position: absolute;
  z-index: 1;
  top: 11rpx;
  bottom: -35rpx;
  left: 90rpx;
  width: 2rpx;
  border-radius: 999rpx;
  background: #a0a099;
  pointer-events: none;
  transform: translateX(-50%);
}

.timeline-item:last-child.is-selected::before {
  bottom: 18rpx;
}

.timeline-item.is-selected.has-conflict::before {
  background: #bd5b55;
}

.timeline-rail {
  position: relative;
  min-height: 156rpx;
}

.time-stamp {
  position: relative;
  z-index: 2;
  width: 68rpx;
  padding: 0 0 8rpx;
  background: #ffffff;
  text-align: right;
}

.timeline-node {
  position: absolute;
  z-index: 3;
  top: 0;
  left: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 16rpx;
  height: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #b0b0a9;
  border-radius: 50%;
  background: #ffffff;
  transform: translateX(-50%);
}

.timeline-node.is-selected {
  border-color: #8d8d85;
  background: #8d8d85;
}

.timeline-node.has-conflict {
  top: 2rpx;
  left: 90rpx;
  width: 16rpx;
  height: 16rpx;
  border: 0;
  background: #bd4b4b;
}

.conflict-cross {
  position: relative;
  width: 100%;
  height: 100%;
}

.conflict-cross-line {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 2rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.conflict-cross-line.is-a {
  transform: translate(-50%, -50%) rotate(45deg);
}

.conflict-cross-line.is-b {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.screening-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 142rpx;
  gap: 16rpx;
  align-items: center;
  padding: 28rpx 24rpx 28rpx 28rpx;
  border: 1rpx solid #f0f0ec;
  border-radius: 16rpx;
  background: #f7f7f5;
}

.mock-stamp {
  position: absolute;
  top: 14rpx;
  right: -2rpx;
  z-index: 3;
  padding: 5rpx 10rpx;
  border: 2rpx solid rgba(181, 45, 34, 0.72);
  border-right: 0;
  border-radius: 6rpx 0 0 6rpx;
  background: rgba(255, 240, 238, 0.92);
  color: #b52d22;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0;
  transform: rotate(-6deg);
  transform-origin: right center;
  pointer-events: none;
}

.screening-card.is-selected {
  border-color: #f0f0ec;
  background: #f7f7f5;
  box-shadow: none;
}

.start {
  color: #171917;
  font-size: 25rpx;
  font-weight: 600;
}

.end {
  display: block;
  margin-top: 6rpx;
  color: #858982;
  font-size: 20rpx;
}

.screening-body {
  display: block;
  min-width: 0;
  color: inherit;
}

.screen-info {
  min-width: 0;
}

.screen-title {
  min-width: 0;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.3;
}

.screen-meta-line,
.venue-line {
  margin-top: 6rpx;
  color: #686f69;
  font-size: 23rpx;
  line-height: 1.4;
}

.rating-line {
  margin-top: 6rpx;
  color: #8f6b1c;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
}

.screen-meta {
  color: #686f69;
}

.tag-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.interest,
.price,
.ticket,
.popularity {
  padding: 6rpx 11rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #626760;
  font-size: 20rpx;
  line-height: 1.2;
}

.popularity {
  color: #536b84;
  background: #eef4f7;
  font-weight: 600;
}

.screen-rating {
  align-self: center;
  color: #896519;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
}

.interest {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

.interest.tone-teal,
.interest.tone-amber,
.interest.tone-red {
  background: #ffffff;
  color: #626760;
}

.interest-word {
  color: #626760;
}

.interest-stars {
  color: #e3b53f;
  font-weight: 600;
}

.tone-gray {
  background: #f0efec;
  color: #6b6964;
}

.screening-actions {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.pick-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  width: 100%;
  min-width: 0;
  height: 56rpx;
  padding: 0 9rpx;
  box-sizing: border-box;
  border: 2rpx solid #cfd2cc;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2e352f;
  font-size: 21rpx;
  font-weight: 600;
  overflow: hidden;
}

.action-tap {
  opacity: 0.72;
  transform: scale(0.98);
}

.pick-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 20rpx;
  height: 20rpx;
  color: currentColor;
}

.pick-symbol.is-filled {
  color: currentColor;
}

.action-glyph {
  position: relative;
  width: 100%;
  height: 100%;
}

.glyph-line {
  position: absolute;
  left: 50%;
  top: 50%;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform-origin: center;
}

.action-glyph.is-plus .glyph-line {
  width: 16rpx;
}

.action-glyph.is-plus .is-a {
  transform: translate(-50%, -50%);
}

.action-glyph.is-plus .is-b {
  transform: translate(-50%, -50%) rotate(90deg);
}

.action-glyph.is-check .glyph-line {
  background: currentColor;
}

.action-glyph.is-check .is-a {
  width: 8rpx;
  transform: translate(-75%, 40%) rotate(45deg);
}

.action-glyph.is-check .is-b {
  width: 16rpx;
  transform: translate(-20%, -8%) rotate(-45deg);
}

.pick-label {
  flex: 0 0 auto;
  color: currentColor;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.15;
  white-space: nowrap;
}

.pick-button.is-on {
  border-color: #171917;
  background: #171917;
  color: #ffffff;
}

.pick-button.is-on .pick-label {
  color: currentColor;
}

.pick-button.has-conflict {
  border-color: #cfd2cc;
  color: #2e352f;
}

.pick-button.is-switch {
  border-color: #b9c0b8;
  background: #fbfcfa;
}

.action-note {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  margin-top: 8rpx;
  max-width: 100%;
  overflow: hidden;
  color: #8b9189;
  font-size: 18rpx;
  line-height: 1.1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  margin: 108rpx 34rpx 0;
  text-align: center;
}

.empty-start {
  max-width: 620rpx;
  margin: 0 auto;
}

.empty-copy {
  max-width: 560rpx;
  margin: 0 auto;
}

.empty-line {
  color: #737872;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.45;
}

.empty-line + .empty-line {
  margin-top: 8rpx;
}

.empty-paragraph {
  color: #737872;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.55;
}

.empty-sentence + .empty-sentence {
  margin-top: 18rpx;
}

.empty-inline-link {
  display: inline-block;
  color: #171917;
  font-weight: 600;
  white-space: nowrap;
}

.empty-inline-tap {
  opacity: 0.7;
}
