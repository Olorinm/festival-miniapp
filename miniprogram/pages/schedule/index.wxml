<view class="app-custom-nav" style="height: {{navTotalHeight}}px;">
  <view class="app-nav-row" style="top: {{navTop}}px; height: {{navHeight}}px; padding-right: {{navRight}}px;">
    <navigator class="app-about-entry" url="/pages/about/index" hover-class="app-about-tap">
      <image class="app-about-icon" src="/assets/brand/opengrove-sapling-on-light.png" mode="aspectFit" />
      <text>关于</text>
    </navigator>
    <view class="app-nav-title is-festival-title">
      <view class="app-nav-edition">
        <text class="app-nav-number">28</text>
        <text class="app-nav-suffix">th</text>
      </view>
      <text class="app-nav-word">SIFF</text>
    </view>
  </view>
</view>

<view class="page schedule-page" style="padding-top: {{contentTop}}px;">
  <view class="schedule-top">
    <view class="schedule-tool-row">
      <view class="search-box schedule-search">
        <text class="search-icon">⌕</text>
        <input class="search-input" value="{{query}}" bindinput="onSearchInput" placeholder="搜片名、导演、影院" confirm-type="search" />
      </view>

      <view class="smart-entry" bindtap="openSmartPlan">
        <view class="smart-icon">
          <view class="smart-spark">
            <view class="smart-spark-point is-top"></view>
            <view class="smart-spark-point is-right"></view>
            <view class="smart-spark-point is-bottom"></view>
            <view class="smart-spark-point is-left"></view>
            <view class="smart-spark-core"></view>
          </view>
        </view>
        <text class="smart-entry-label">智能排片</text>
        <text class="smart-arrow">›</text>
      </view>
    </view>

    <view class="schedule-filter-bar">
      <view class="scope-segment">
        <view
          wx:for="{{filterChips}}"
          wx:key="key"
          class="scope-option {{item.active ? 'is-active' : ''}}"
          data-type="{{item.type}}"
          data-value="{{item.value}}"
          bindtap="tapFilter"
        >
          <text class="filter-label">{{item.label}}</text>
        </view>
      </view>

      <view class="tool-filter-chip {{filterPanelOpen ? 'is-active' : ''}}" bindtap="toggleFilterPanel">
        <text class="filter-label">筛选</text>
        <text wx:if="{{filterActiveCount}}" class="filter-count">· {{filterActiveCount}}</text>
      </view>

      <view class="tool-filter-chip {{fieldPanelOpen ? 'is-active' : ''}}" bindtap="toggleFieldPanel">
        <text class="filter-label">字段</text>
      </view>

      <view
        wx:if="{{hasDayGroups}}"
        class="group-toggle-icon {{allDaysCollapsed ? 'is-expand' : 'is-collapse'}} schedule-group-toggle"
        bindtap="toggleAllDayGroups"
      ></view>
    </view>

    <view wx:if="{{filterPanelOpen}}" class="filter-panel">
      <view wx:for="{{filterGroups}}" wx:for-item="group" wx:key="type" class="filter-group">
        <view class="filter-group-head">
          <text class="filter-group-label">{{group.label}}</text>
        </view>
        <scroll-view class="filter-group-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="filter-group-row">
            <view
              wx:for="{{group.options}}"
              wx:key="key"
              class="filter-option {{item.picked ? 'is-picked' : ''}}"
              data-type="{{group.type}}"
              data-value="{{item.key}}"
              bindtap="selectFilterOption"
            >
              <text class="filter-option-label">{{item.label}}</text>
              <text class="filter-option-count">{{item.count}}</text>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="filter-group">
        <view class="filter-group-head">
          <text class="filter-group-label">豆瓣评分</text>
          <text class="filter-slider-value">{{doubanMin > 0 ? doubanMin + ' 分以上' : '不限'}}</text>
        </view>
        <slider min="0" max="9.5" step="0.5" value="{{doubanMin}}" block-size="20" activeColor="#171917" bindchanging="onDoubanChanging" bindchange="onDoubanChange" />
      </view>

      <view class="filter-group">
        <view class="filter-group-head">
          <text class="filter-group-label">IMDb 评分</text>
          <text class="filter-slider-value">{{imdbMin > 0 ? imdbMin + ' 分以上' : '不限'}}</text>
        </view>
        <slider min="0" max="9.5" step="0.5" value="{{imdbMin}}" block-size="20" activeColor="#171917" bindchanging="onImdbChanging" bindchange="onImdbChange" />
      </view>

      <view wx:if="{{filterActiveCount}}" class="filter-panel-reset" bindtap="resetFilters">重置筛选</view>
    </view>

    <view wx:if="{{fieldPanelOpen}}" class="filter-panel">
      <view
        wx:for="{{fieldOptions}}"
        wx:key="key"
        class="field-row"
        data-key="{{item.key}}"
        bindtap="toggleField"
      >
        <view class="field-row-text">
          <view class="field-row-label">{{item.label}}</view>
          <view wx:if="{{item.desc}}" class="field-row-desc">{{item.desc}}</view>
        </view>
        <view class="field-switch {{fieldConfig[item.key] ? 'is-on' : ''}}">
          <view class="field-switch-dot"></view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{dataLoading}}" class="empty-state">
    <view class="empty-copy">
      <view class="empty-line">片单加载中</view>
    </view>
  </view>

  <view wx:elif="{{screeningCount === 0}}" class="empty-state">
    <view wx:if="{{emptyShowActions}}" class="empty-start">
      <view class="empty-paragraph">
        <view class="empty-sentence">
          <text>还没有标记任何电影，你可以 </text>
          <text class="empty-inline-link" bindtap="goFilms" hover-class="empty-inline-tap">选电影›</text>
        </view>
        <view class="empty-sentence">
          <text>也可以看 </text>
          <text class="empty-inline-link" bindtap="showAllScreenings" hover-class="empty-inline-tap">全部场次›</text>
          <text>，打开完整时间表</text>
        </view>
        <view class="empty-sentence">
          <text>也可以讲讲需求，让 </text>
          <text class="empty-inline-link" bindtap="openSmartPlan" hover-class="empty-inline-tap">智能排片›</text>
          <text> 排一版</text>
        </view>
      </view>
    </view>
    <view wx:else class="empty-copy">
      <view class="empty-line">{{emptyTitle}}</view>
    </view>
  </view>

  <view wx:if="{{!dataLoading}}" class="screening-days">
    <view wx:for="{{screeningGroups}}" wx:for-item="group" wx:key="date" class="screening-day">
      <view wx:if="{{showDayHeaders}}" class="screening-day-head" data-day="{{group.date}}" bindtap="toggleDayGroup">
        <view class="screening-day-left">
          <text class="screening-day-caret {{group.expanded ? 'is-open' : ''}}">{{group.expanded ? '⌄' : '›'}}</text>
          <text class="screening-day-label">{{group.headerText}}</text>
        </view>
        <view class="screening-day-count">{{group.count}} 场</view>
      </view>

      <view wx:if="{{group.expanded}}" class="screening-list">
        <view wx:for="{{group.items}}" wx:for-item="item" wx:key="id" class="timeline-item {{item.selected ? 'is-selected' : ''}} {{item.conflict ? 'has-conflict' : ''}}">
          <view class="timeline-rail">
            <view class="time-stamp">
              <text class="start mono">{{item.start}}</text>
              <text class="end mono">{{item.end}}</text>
            </view>
            <view class="timeline-node {{item.selected ? 'is-selected' : ''}} {{item.conflict ? 'has-conflict' : ''}}">
              <view wx:if="{{item.conflict}}" class="conflict-cross">
                <view class="conflict-cross-line is-a"></view>
                <view class="conflict-cross-line is-b"></view>
              </view>
            </view>
          </view>

          <view class="screening-card {{item.selected ? 'is-selected' : ''}}">
            <view wx:if="{{item.isMock}}" class="mock-stamp">{{item.mockLabel ? item.mockLabel : '测试场次'}}</view>
            <navigator class="screening-body" url="/pages/film/detail?id={{item.filmId}}">
              <view class="screen-info">
                <view class="screen-title-row">
                  <view class="screen-title">{{item.cnTitle}}</view>
                </view>
                <view wx:if="{{fieldConfig.info && (item.cardMeta || item.screenMeta)}}" class="screen-meta-line">
                  <text class="screen-meta">{{item.cardMeta || item.screenMeta}}</text>
                </view>
                <view wx:if="{{fieldConfig.rating && item.ratingSummary}}" class="rating-line">{{item.ratingSummary}}</view>
                <view wx:if="{{fieldConfig.synopsis && item.synopsis}}" class="screen-synopsis">{{item.synopsis}}</view>
                <view class="venue-line">{{item.cinema}} · {{item.hall}}</view>
                <view class="tag-line">
                  <view class="interest tone-{{item.interestTone}}">
                    <text class="interest-word">{{item.interestWord}}</text>
                    <text wx:if="{{item.interestStars}}" class="interest-stars">{{item.interestStars}}</text>
                  </view>
                  <text wx:if="{{item.price}}" class="price">¥{{item.price}}</text>
                  <text wx:if="{{fieldConfig.ticket && item.ticket}}" class="ticket">{{item.ticket}}</text>
                  <text wx:if="{{fieldConfig.popularity && item.popularityText}}" class="popularity">{{item.popularityText}}</text>
                </view>
              </view>
            </navigator>

            <view class="screening-actions">
              <view
                class="pick-button {{item.selected ? 'is-on' : ''}} {{item.filmScheduled && !item.selected ? 'is-switch' : ''}} {{item.pickConflict ? 'has-conflict' : ''}}"
                data-id="{{item.id}}"
                hover-class="action-tap"
                hover-start-time="0"
                hover-stay-time="80"
                bindtap="toggleScreening"
              >
                <view class="pick-symbol {{item.selected ? 'is-filled' : ''}}">
                  <view class="action-glyph {{item.selected ? 'is-check' : 'is-plus'}}">
                    <view class="glyph-line is-a"></view>
                    <view class="glyph-line is-b"></view>
                  </view>
                </view>
                <text class="pick-label">{{item.selected ? '已排' : '加入'}}</text>
              </view>
              <text wx:if="{{item.filmScheduled && !item.selected}}" class="action-note">已排过这部</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <smart-plan id="smartPlan"></smart-plan>
  <view wx:if="{{showScrollTop}}" class="scroll-top-button" bindtap="scrollToTop"></view>
</view>
