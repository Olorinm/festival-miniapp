<view wx:if="{{film}}" class="page detail-page">
  <view class="film-head tone-{{film.interest.tone}}">
    <view class="detail-poster {{film.hasPoster ? '' : 'is-placeholder'}}">
      <image wx:if="{{film.hasPoster}}" class="detail-poster-image" src="{{film.posterSrc}}" mode="aspectFill" lazy-load="true" />
      <view wx:else class="detail-poster-placeholder">暂无海报</view>
    </view>
    <view class="head-main">
      <view class="film-title">{{film.cnTitle}}</view>
      <view wx:if="{{film.enTitle}}" class="film-en">{{film.enTitle}}</view>
      <view wx:if="{{film.headMetaRows.length}}" class="film-meta">
        <view wx:for="{{film.headMetaRows}}" wx:key="*this" class="film-meta-line">{{item}}</view>
      </view>
      <view wx:if="{{film.detailTags.length}}" class="detail-fact-row">
        <text wx:for="{{film.detailTags}}" wx:key="*this" class="detail-tag">{{item}}</text>
      </view>
      <view wx:if="{{film.ratingItems.length}}" class="rating-strip">
        <view
          wx:for="{{film.ratingItems}}"
          wx:key="key"
          class="rating-item rating-{{item.key}}"
          data-url="{{item.href}}"
          bindtap="copyRatingLink"
        >
          <text class="rating-label">{{item.label}}</text>
          <text class="rating-value">{{item.value}}</text>
          <text wx:if="{{item.extra}}" class="rating-extra">{{item.extra}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{film.recommendation}}" class="recommendation-block">
    <view class="info-title">官方推荐语</view>
    <view class="recommendation">{{film.recommendation}}</view>
  </view>

  <view wx:if="{{film.synopsis}}" class="recommendation-block synopsis-block">
    <view class="info-title">剧情简介</view>
    <view class="recommendation">{{film.synopsis}}</view>
  </view>

  <view wx:if="{{film.hasInfoRows}}" class="section info-section">
    <view wx:if="{{film.hasInfoRows}}" class="info-list">
      <view wx:for="{{film.infoRows}}" wx:key="label" class="info-row {{item.multiline ? 'is-multiline' : ''}}">
        <text class="info-label">{{item.label}}</text>
        <view wx:if="{{item.multiline}}" class="info-value info-value-long">
          <text wx:for="{{item.lines}}" wx:key="*this" class="info-value-line">{{item}}</text>
        </view>
        <text wx:else class="info-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">想看程度</view>
    <view class="star-line">
      <view class="star-row">
        <view
          wx:for="{{starSlots}}"
          wx:for-item="star"
          wx:key="n"
          class="star-hit"
          data-mark="{{star.mark}}"
          data-current-mark="{{film.mark}}"
          hover-class="star-tap"
          hover-start-time="0"
          hover-stay-time="70"
          bindtap="markFilm"
        >
          <view class="star {{film.interest.rank >= star.n ? 'is-on' : ''}}"></view>
        </view>
      </view>
      <text class="star-word {{film.interest.rank ? 'is-set' : ''}}">{{film.interestWord}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">可选场次</view>
    <view wx:for="{{screenings}}" wx:key="id" class="screening-card {{item.selected ? 'is-selected' : ''}} {{item.conflict ? 'has-conflict' : ''}}">
      <view wx:if="{{item.isMock}}" class="mock-stamp">{{item.mockLabel ? item.mockLabel : '测试场次'}}</view>
      <view class="screening-main">
        <view class="screening-time">
          <text class="day">{{item.dayLabel}}</text>
          <text class="time mono">{{item.timeRange}}</text>
        </view>
        <view class="venue">{{item.cinema}} · {{item.hall}}</view>
        <view class="ticket-row">
          <text wx:if="{{item.ticketPlan}}">{{item.ticketPlan}}</text>
          <text wx:if="{{item.price}}" class="price">¥{{item.price}}</text>
          <text wx:if="{{item.specialTag}}" class="special-tag">{{item.specialTag}}</text>
          <text wx:if="{{item.popularityText}}" class="popularity">{{item.popularityText}}</text>
        </view>
        <view wx:if="{{item.conflict}}" class="conflict">冲突：{{item.conflictText}}</view>
      </view>
      <view class="screening-actions">
        <view
          class="pick-button {{item.selected ? 'is-on' : ''}}"
          data-id="{{item.id}}"
          hover-class="action-tap"
          hover-start-time="0"
          hover-stay-time="80"
          bindtap="toggleScreening"
        >
          <view class="pick-symbol {{item.selected ? 'is-filled' : ''}}">
            <view class="action-glyph {{item.selected ? 'is-check' : 'is-plus'}}">
              <view class="glyph-line is-a"></view>
              <view class="glyph-line is-b"></view>
            </view>
          </view>
          <text class="pick-label">{{item.selected ? '已排' : '加入排片'}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
