.detail-page {
  padding-top: 14rpx;
}

.film-head {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  background: #fff;
  border: 1rpx solid #e7e7e1;
  color: #161716;
}

.head-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  height: 72rpx;
  border: 1rpx solid #ecece7;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 680;
}

.head-main {
  min-width: 0;
  flex: 1;
}

.film-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.film-en {
  margin-top: 8rpx;
  color: #8d918b;
  font-size: 24rpx;
  line-height: 1.35;
}

.film-meta {
  margin-top: 8rpx;
  color: #686f69;
  font-size: 23rpx;
  line-height: 1.35;
}

.tone-red {
  border-color: #deddd6;
}

.tone-amber {
  border-color: #eadfcf;
}

.tone-teal {
  border-color: #d4e5e2;
}

.tone-blue {
  border-color: #d9e0e8;
}

.tone-gray {
  border-color: #e1e1dc;
}

.tone-red .head-mark {
  border-color: #1f211d;
  background: #1f211d;
  color: #f0c864;
}

.tone-amber .head-mark {
  background: #fff6e8;
  color: #9b661e;
}

.tone-teal .head-mark {
  background: #ecf7f4;
  color: #0f766e;
}

.tone-blue .head-mark {
  background: #eef4f8;
  color: #41607c;
}

.tone-gray .head-mark {
  background: #f0f0ec;
  color: #757870;
}

.section {
  margin-top: 24rpx;
}

.section-title {
  margin-bottom: 12rpx;
  color: #171917;
  font-size: 28rpx;
  font-weight: 680;
}

.mark-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6rpx;
  padding: 0;
  border-radius: 8rpx;
  background: transparent;
}

.mark-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 50rpx;
  border: 1rpx solid #e4e4df;
  border-radius: 6rpx;
  background: #ffffff;
  color: #7f837d;
  font-size: 22rpx;
  font-weight: 650;
  overflow: hidden;
  transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
}

.mark-button.is-picked {
  font-weight: 700;
}

.mark-button.tone-red.is-picked {
  border-color: #1f211d;
  background: #1f211d;
  color: #f0c864;
}

.mark-button.tone-amber.is-picked {
  border-color: #e3d6bd;
  background: #f4ecd9;
  color: #7d5a24;
}

.mark-button.tone-teal.is-picked {
  border-color: #d6ded7;
  background: #edf2ee;
  color: #536158;
}

.mark-button:active {
  border-color: #c9cbc5;
  background: #f0f0ec;
}

.mark-button.tone-red.is-picked:active {
  border-color: #1f211d;
  background: #1f211d;
}

.mark-button.tone-amber.is-picked:active {
  border-color: #e3d6bd;
  background: #f4ecd9;
}

.mark-button.tone-teal.is-picked:active {
  border-color: #d6ded7;
  background: #edf2ee;
}

.screening-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 158rpx;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx 28rpx 28rpx;
  border: 1rpx solid #f0f0ec;
  border-radius: 16rpx;
  background: #f7f7f5;
}

.screening-card.is-selected {
  border-color: #f0f0ec;
  background: #f7f7f5;
  box-shadow: none;
}

.screening-card.has-conflict {
  border-color: #d7a35e;
  background: #fffaf2;
}

.screening-main {
  min-width: 0;
}

.screening-time {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.day {
  color: #33302c;
  font-size: 28rpx;
  font-weight: 720;
}

.time {
  color: #171917;
  font-size: 28rpx;
  font-weight: 720;
}

.venue,
.ticket-row,
.conflict {
  margin-top: 10rpx;
  color: #686f69;
  font-size: 22rpx;
  line-height: 1.4;
}

.ticket-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  margin-top: 14rpx;
}

.ticket-row text,
.price {
  padding: 6rpx 11rpx;
  border-radius: 7rpx;
  background: #ffffff;
  color: #626760;
  font-size: 20rpx;
  line-height: 1.2;
}

.price {
  color: #a72f36;
  font-weight: 660;
}

.conflict {
  color: #a65e11;
}

.screening-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
}

.pick-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
  height: 62rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #cfd2cc;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2e352f;
  font-size: 22rpx;
  font-weight: 680;
  overflow: hidden;
}

.action-tap {
  opacity: 0.72;
  transform: scale(0.98);
}

.pick-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 24rpx;
  height: 24rpx;
  color: currentColor;
}

.pick-symbol.is-filled {
  color: currentColor;
}

.action-glyph {
  position: relative;
  width: 100%;
  height: 100%;
}

.glyph-line {
  position: absolute;
  left: 50%;
  top: 50%;
  height: 3rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform-origin: center;
}

.action-glyph.is-plus .glyph-line {
  width: 18rpx;
}

.action-glyph.is-plus .is-a {
  transform: translate(-50%, -50%);
}

.action-glyph.is-plus .is-b {
  transform: translate(-50%, -50%) rotate(90deg);
}

.action-glyph.is-check .glyph-line {
  background: currentColor;
}

.action-glyph.is-check .is-a {
  width: 9rpx;
  transform: translate(-75%, 40%) rotate(45deg);
}

.action-glyph.is-check .is-b {
  width: 18rpx;
  transform: translate(-20%, -8%) rotate(-45deg);
}

.pick-label {
  max-width: 100%;
  overflow: hidden;
  color: currentColor;
  font-size: 22rpx;
  font-weight: 680;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pick-button.is-on {
  border-color: #171917;
  background: #171917;
  color: #ffffff;
}

.pick-button.is-on .pick-label {
  color: currentColor;
}
