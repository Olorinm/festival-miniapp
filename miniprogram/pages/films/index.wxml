<view class="app-custom-nav" style="height: {{navTotalHeight}}px;">
  <view class="app-nav-row" style="top: {{navTop}}px; height: {{navHeight}}px; padding-right: {{navRight}}px;">
    <navigator class="app-about-entry" url="/pages/about/index" hover-class="app-about-tap">
      <image class="app-about-icon" src="/assets/brand/opengrove-sapling-on-light.png" mode="aspectFit" />
      <text>关于</text>
    </navigator>
    <view class="app-nav-title is-festival-title">
      <view class="app-nav-edition">
        <text class="app-nav-number">28</text>
        <text class="app-nav-suffix">th</text>
      </view>
      <text class="app-nav-word">SIFF</text>
    </view>
  </view>
</view>

<view class="page films-page" style="padding-top: {{contentTop}}px;">
  <view class="films-top">
    <view class="films-tool-row">
      <view class="search-box films-search">
        <text class="search-icon">⌕</text>
        <input class="search-input" value="{{query}}" bindinput="onSearchInput" placeholder="搜片名、导演、单元" confirm-type="search" />
      </view>

      <view class="smart-entry" bindtap="openSmartPlan">
        <view class="smart-icon">
          <view class="smart-spark">
            <view class="smart-spark-point is-top"></view>
            <view class="smart-spark-point is-right"></view>
            <view class="smart-spark-point is-bottom"></view>
            <view class="smart-spark-point is-left"></view>
            <view class="smart-spark-core"></view>
          </view>
        </view>
        <text class="smart-entry-label">智能排片</text>
        <text class="smart-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="film-filter-bar">
    <scroll-view class="film-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="film-filter-row">
        <view class="interest-segment">
          <view
            wx:for="{{filters}}"
            wx:key="key"
            wx:if="{{item.type !== 'sort'}}"
            class="interest-option {{activeInterest === item.key ? 'is-active' : ''}}"
            data-key="{{item.key}}"
            data-type="{{item.type}}"
            bindtap="handleFilterTap"
          >
            <text class="pill-label">{{item.label}}</text>
          </view>
        </view>

        <view
          wx:for="{{filters}}"
          wx:key="key"
          wx:if="{{item.type === 'sort'}}"
          class="film-tool-chip {{sortOpen ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          data-type="{{item.type}}"
          bindtap="handleFilterTap"
        >
          <text class="film-tool-label">{{sortFilterLabel}}</text>
          <text class="filter-triangle">▼</text>
        </view>

        <view class="film-tool-chip {{filterPanelOpen ? 'is-active' : ''}}" bindtap="toggleFilterPanel">
          <text class="film-tool-label">筛选</text>
          <text wx:if="{{filterActiveCount}}" class="filter-count">· {{filterActiveCount}}</text>
        </view>

        <view class="film-tool-chip {{fieldPanelOpen ? 'is-active' : ''}}" bindtap="toggleFieldPanel">
          <text class="film-tool-label">字段</text>
        </view>
      </view>
    </scroll-view>

    <view
      wx:if="{{hasGroupedView}}"
      class="group-toggle-icon {{allGroupsCollapsed ? 'is-expand' : 'is-collapse'}}"
      bindtap="toggleAllGroups"
    ></view>
  </view>

  <view wx:if="{{sortOpen}}" class="sort-panel">
    <view class="sort-grid">
      <view
        wx:for="{{sortOptions}}"
        wx:key="key"
        class="sort-option {{activeSort === item.key ? 'is-picked' : ''}}"
        data-sort="{{item.key}}"
        bindtap="selectSort"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{filterPanelOpen}}" class="filter-panel">
    <view class="filter-group">
      <view class="filter-group-head"><text class="filter-group-label">单元</text></view>
      <scroll-view class="filter-group-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="filter-group-row">
          <view
            wx:for="{{sectionOptions}}"
            wx:key="key"
            class="filter-option {{item.picked ? 'is-picked' : ''}}"
            data-type="section"
            data-value="{{item.key}}"
            bindtap="selectFilterOption"
          >
            <text class="filter-option-label">{{item.label}}</text>
            <text class="filter-option-count">{{item.count}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="filter-group">
      <view class="filter-group-head"><text class="filter-group-label">导演</text></view>
      <scroll-view class="filter-group-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="filter-group-row">
          <view
            wx:for="{{directorFilterOptions}}"
            wx:key="key"
            class="filter-option {{item.picked ? 'is-picked' : ''}}"
            data-type="director"
            data-value="{{item.key}}"
            bindtap="selectFilterOption"
          >
            <text class="filter-option-label">{{item.label}}</text>
            <text class="filter-option-count">{{item.count}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="filter-group">
      <view class="filter-group-head">
        <text class="filter-group-label">豆瓣评分</text>
        <text class="filter-slider-value">{{doubanMin > 0 ? doubanMin + ' 分以上' : '不限'}}</text>
      </view>
      <slider min="0" max="9.5" step="0.5" value="{{doubanMin}}" block-size="20" activeColor="#171917" bindchanging="onDoubanChanging" bindchange="onDoubanChange" />
    </view>

    <view class="filter-group">
      <view class="filter-group-head">
        <text class="filter-group-label">IMDb 评分</text>
        <text class="filter-slider-value">{{imdbMin > 0 ? imdbMin + ' 分以上' : '不限'}}</text>
      </view>
      <slider min="0" max="9.5" step="0.5" value="{{imdbMin}}" block-size="20" activeColor="#171917" bindchanging="onImdbChanging" bindchange="onImdbChange" />
    </view>

    <view wx:if="{{filterActiveCount}}" class="filter-panel-reset" bindtap="resetFilters">重置筛选</view>
  </view>

  <view wx:if="{{fieldPanelOpen}}" class="field-panel">
    <view
      wx:for="{{fieldOptions}}"
      wx:key="key"
      class="field-row"
      data-key="{{item.key}}"
      bindtap="toggleField"
    >
      <view class="field-row-text">
        <view class="field-row-label">{{item.label}}</view>
        <view wx:if="{{item.desc}}" class="field-row-desc">{{item.desc}}</view>
      </view>
      <view class="field-switch {{fieldConfig[item.key] ? 'is-on' : ''}}">
        <view class="field-switch-dot"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{films.length === 0}}" class="empty">
    <view class="empty-title">无结果</view>
  </view>

  <view class="film-list">
    <view
      wx:for="{{filmGroups}}"
      wx:for-item="group"
      wx:for-index="groupIndex"
      wx:key="key"
      class="film-group"
    >
      <view wx:if="{{activeSort !== 'default'}}" class="group-header" data-key="{{group.key}}" bindtap="toggleGroup">
        <view class="group-left">
          <text class="group-caret-symbol {{group.expanded ? 'is-open' : ''}}">{{group.expanded ? '⌄' : '›'}}</text>
          <view class="group-label">{{group.headerText || groupHeaderFallback}}</view>
        </view>
        <view class="group-side">
          <text class="group-count">{{group.count}} 部</text>
        </view>
      </view>

      <view wx:if="{{group.expanded}}" class="group-list">
        <view
          wx:for="{{group.items}}"
          wx:for-item="item"
          wx:for-index="filmIndex"
          wx:key="id"
          class="film-card mark-{{item.interest.tone}}"
          data-id="{{item.id}}"
          bindtap="openFilm"
        >
          <view class="film-main">
            <view class="film-poster {{item.hasPoster ? '' : 'is-placeholder'}}">
              <image wx:if="{{item.hasPoster}}" class="film-poster-image" src="{{item.posterSrc}}" mode="aspectFill" lazy-load="true" />
              <view wx:else class="poster-placeholder">暂无海报</view>
            </view>
            <view class="film-info">
              <view class="title-row">
                <view class="film-title">{{item.cnTitle}}</view>
              </view>
              <view wx:if="{{item.enTitle}}" class="film-en">{{item.enTitle}}</view>
              <view wx:if="{{fieldConfig.info && item.metaText}}" class="film-meta">{{item.metaText}}</view>
              <view wx:if="{{(fieldConfig.info && item.sectionLabel) || (fieldConfig.rating && item.ratingSummary)}}" class="film-fact-row">
                <text wx:if="{{fieldConfig.info && item.sectionLabel}}" class="film-section">{{item.sectionLabel}}</text>
                <text wx:if="{{fieldConfig.rating && item.ratingSummary}}" class="film-rating">{{item.ratingSummary}}</text>
              </view>
              <view wx:if="{{fieldConfig.synopsis && item.synopsisText}}" class="film-synopsis">{{item.synopsisText}}</view>
            </view>
            <view class="star-rail" catchtap="noop">
              <view
                wx:for="{{starSlots}}"
                wx:for-item="star"
                wx:key="n"
                class="star-hit"
                data-film-id="{{item.id}}"
                data-group-index="{{groupIndex}}"
                data-film-index="{{filmIndex}}"
                data-mark="{{star.mark}}"
                data-current-mark="{{item.mark}}"
                hover-class="star-tap"
                hover-start-time="0"
                hover-stay-time="70"
                catchtap="markFilm"
              >
                <view class="star {{item.interest.rank >= star.n ? 'is-on' : ''}}"></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <smart-plan id="smartPlan"></smart-plan>
  <view wx:if="{{showScrollTop}}" class="scroll-top-button" bindtap="scrollToTop"></view>
</view>
