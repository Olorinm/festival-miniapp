.smart-spark {
  position: relative;
  width: 36rpx;
  height: 36rpx;
}

.smart-spark-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: translate(-50%, -50%) rotate(45deg);
}

.smart-spark-point {
  position: absolute;
  width: 0;
  height: 0;
}

.smart-spark-point.is-top {
  left: 50%;
  top: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 18rpx solid currentColor;
  transform: translateX(-50%);
}

.smart-spark-point.is-right {
  right: 0;
  top: 50%;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 18rpx solid currentColor;
  transform: translateY(-50%);
}

.smart-spark-point.is-bottom {
  left: 50%;
  bottom: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 18rpx solid currentColor;
  transform: translateX(-50%);
}

.smart-spark-point.is-left {
  left: 0;
  top: 50%;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-right: 18rpx solid currentColor;
  transform: translateY(-50%);
}

.smart-mask {
  position: fixed;
  z-index: 80;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 34rpx;
  background: rgba(22, 23, 22, 0.34);
}

.smart-sheet {
  width: 100%;
  max-width: 650rpx;
  max-height: 72vh;
  padding: 30rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 80rpx rgba(22, 23, 22, 0.2);
}

.smart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.smart-title {
  color: #161716;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.15;
}

.smart-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  color: #8b9088;
  font-size: 34rpx;
  line-height: 1;
}

.smart-input-shell {
  box-sizing: border-box;
  width: 100%;
  min-height: 286rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  background: #f7f8f4;
}

.smart-input-shell.is-focused {
  border-color: #dfe2da;
  background: #ffffff;
  box-shadow: 0 0 0 4rpx rgba(23, 25, 23, 0.035);
}

.smart-prompt-title {
  color: #525852;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.45;
}

.smart-prompt-line {
  margin-top: 7rpx;
  color: #7b817b;
  font-size: 24rpx;
  line-height: 1.42;
}

.smart-input {
  display: block;
  width: 100%;
  max-width: 100%;
  min-height: 82rpx;
  max-height: 340rpx;
  margin-top: 16rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #171917;
  font-size: 26rpx;
  line-height: 1.48;
}

.smart-input.has-value {
  min-height: 228rpx;
  margin-top: 0;
}

.smart-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
}

.smart-secondary,
.smart-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 68rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.smart-secondary {
  flex: 0 0 auto;
  min-width: 112rpx;
  padding: 0 10rpx;
  color: #7a8078;
}

.smart-primary {
  position: relative;
  gap: 10rpx;
  flex: 1 1 auto;
  border-radius: 999rpx;
  background: #171917;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(22, 23, 22, 0.16);
}

.smart-primary-spark {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 42rpx;
  width: 42rpx;
  height: 42rpx;
  color: #d3b45d;
  transform-origin: 50% 50%;
}

.smart-primary-spark .smart-spark {
  width: 34rpx;
  height: 34rpx;
}

.smart-primary-spark .smart-spark-core {
  width: 11rpx;
  height: 11rpx;
}

.smart-primary-spark .smart-spark-point.is-top {
  border-left-width: 7rpx;
  border-right-width: 7rpx;
  border-bottom-width: 17rpx;
}

.smart-primary-spark .smart-spark-point.is-right {
  border-top-width: 7rpx;
  border-bottom-width: 7rpx;
  border-left-width: 17rpx;
}

.smart-primary-spark .smart-spark-point.is-bottom {
  border-left-width: 7rpx;
  border-right-width: 7rpx;
  border-top-width: 17rpx;
}

.smart-primary-spark .smart-spark-point.is-left {
  border-top-width: 7rpx;
  border-bottom-width: 7rpx;
  border-right-width: 17rpx;
}

.smart-primary-spark.is-spinning {
  animation: smart-button-spin 1.1s linear infinite;
}

.smart-primary-label {
  line-height: 1;
}

.smart-primary.is-disabled {
  background: #5f655e;
  box-shadow: 0 8rpx 20rpx rgba(22, 23, 22, 0.12);
}

@keyframes smart-button-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
