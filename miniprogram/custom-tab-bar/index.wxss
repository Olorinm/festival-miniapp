.custom-tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  justify-content: center;
  padding: 0 22rpx 6px;
  pointer-events: none;
}

.custom-tabbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 704rpx;
  height: 128rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(225, 224, 218, 0.7);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 24rpx 68rpx rgba(33, 34, 31, 0.16), inset 0 2rpx 0 rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(22rpx) saturate(1.35);
  pointer-events: auto;
}

.custom-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  flex: 1 1 0;
  gap: 4rpx;
  min-width: 0;
  height: 108rpx;
  border-radius: 999rpx;
  color: #8d938c;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.custom-tab.is-active {
  background: rgba(255, 255, 255, 0.58);
  color: #171917;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.9), 0 8rpx 28rpx rgba(41, 43, 39, 0.08);
}

.custom-tab-tap {
  opacity: 0.72;
}

.custom-tab-icon {
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 auto;
}

.custom-tab-label {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
